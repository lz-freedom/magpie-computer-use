{
  "name": "magpie-computer-use",
  "version": "0.1.0",
  "description": "让 magpie 里的 Agent 通过 ChatGPT 的 Computer Use 操作 macOS 应用，可把任务委托给 magpie 中指定的模型（报告 + 证据截图）。Lets magpie's agents operate macOS apps through ChatGPT's Computer Use, or delegate the task to a model picked in magpie (factual report + evidence screenshots).",
  "author": "lz-freedom (https://github.com/lz-freedom)",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "bin": {
    "magpie-computer-use": "./bin/magpie-computer-use.mjs"
  },
  "files": [
    "index.mjs",
    "assets",
    "src",
    "page",
    "bin",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CHANGELOG.md",
    "agent.mjs",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "doctor": "node bin/magpie-computer-use.mjs doctor",
    "smoke": "node scripts/smoke-stdio.mjs",
    "mcp": "node bin/magpie-computer-use.mjs mcp"
  },
  "engines": {
    "node": ">=22",
    "magpie": ">=0.1.2075"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "1.101.0",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "computer-use",
    "mcp",
    "lcu",
    "codex",
    "macos",
    "magpie-page",
    "magpie-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lz-freedom/magpie-computer-use.git"
  },
  "bugs": {
    "url": "https://github.com/lz-freedom/magpie-computer-use/issues"
  },
  "homepage": "https://github.com/lz-freedom/magpie-computer-use#readme",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "magpie": {
    "icon": "data:image/png;base64,",
    "options": {
      "model": "",
      "tools": "both",
      "maxSteps": 40
    },
    "page": {
      "title": "MCU",
      "titles": {
        "zh": "MCU"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "agent": "./agent.mjs"
  }
}
